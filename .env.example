# App
APP_NAME=ShopSphere API
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (REQUIRED in production on Vercel)
# Use Neon / Supabase / any Postgres URL.
# Local default if unset: sqlite:///./ecommerce.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://shop-sphereone.vercel.app

# Public frontend URL used in password-reset and order emails
FRONTEND_URL=https://shop-sphereone.vercel.app

# Resend transactional email (backend only — never expose to the frontend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ShopSphere <onboarding@resend.dev>

# Admin inventory highlighting
LOW_STOCK_THRESHOLD=5

# ------------------------------------------------------------
# Cloudflare R2 = object/file storage (NOT a database)
# Only needed later if you upload product images to R2.
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shopsphere-assets
R2_PUBLIC_BASE_URL=https://your-r2-public-domain-or-dev-url
